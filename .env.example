# Optional. Increases GitHub API rate limits for the /api/github route.
# Create a *fine-grained* token with PUBLIC read-only access (no scopes needed for public repos).
# NEVER commit the real value. This variable is read server-side only.
GITHUB_TOKEN=

# Public site URL used for metadata / sitemap / Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://raushankumar.dev
